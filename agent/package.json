{
  "name": "scoped-passkey-agent",
  "version": "1.0.0",
  "description": "AWS AI Agent with Passkey Provisioning & Headless Chrome WebAuthn Automation",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --test dist/test/*.test.js",
    "test:ts": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@sparticuz/chromium": "^123.0.1",
    "dotenv": "^16.4.5",
    "puppeteer": "^22.12.1",
    "puppeteer-core": "^22.15.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2"
  }
}
